# =============================================================================
# UniFi MCP Ecosystem — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Load this trusted file explicitly in your launcher, such as Docker Compose
# env_file or: uv run --env-file /absolute/path/to/.env --with unifi-network-mcp unifi-network-mcp
# Servers do not automatically discover or load .env or config/config.yaml.
# For custom YAML, export CONFIG_PATH=/absolute/path/to/trusted-config.yaml.
# Or keep UNIFI_* lines in a per-user file (chmod 600) and export
# UNIFI_SETTINGS_FILE=~/.config/unifi-mcp/network.env; the environment wins.

# ---------------------------------------------------------------------------
# Shared credentials (used by all servers if server-specific vars not set)
# ---------------------------------------------------------------------------
UNIFI_HOST=192.168.1.1
UNIFI_USERNAME=admin
UNIFI_PASSWORD=your-password-here
# Or keep the secret out of the environment with UNIFI_PASSWORD_FILE=<path>, or
# UNIFI_PASSWORD_COMMAND=<absolute argv, not run through a shell>. Both are
# honoured from the real process environment (docker compose env_file, an
# exported variable, the MCP client's env block). Use an absolute path and
# ensure the launcher and any explicitly loaded env file are trusted.
# See docs/credential-providers.md.
UNIFI_PORT=443
UNIFI_VERIFY_SSL=false
# UNIFI_SSL_FINGERPRINT=              # SHA-256 of the controller certificate: pins it and overrides VERIFY_SSL.
                                      # Consoles differ, so use the per-server variables when they don't share one.
                                      # See docs/tls-verification.md.
# UNIFI_API_KEY=                      # UniFi API key for selected capabilities

# ---------------------------------------------------------------------------
# Network server overrides (optional — falls back to shared UNIFI_* above)
# ---------------------------------------------------------------------------
# UNIFI_NETWORK_HOST=192.168.1.1
# UNIFI_NETWORK_USERNAME=admin
# UNIFI_NETWORK_PASSWORD=
# UNIFI_NETWORK_PORT=443
# UNIFI_NETWORK_VERIFY_SSL=false
# UNIFI_NETWORK_SSL_FINGERPRINT=
# UNIFI_NETWORK_API_KEY=              # Inventory reads without session credentials; see apps/network/README.md
# UNIFI_NETWORK_CONTROLLER_TYPE=auto
UNIFI_NETWORK_SITE=default

# ---------------------------------------------------------------------------
# Protect server overrides (optional — falls back to shared UNIFI_* above)
# ---------------------------------------------------------------------------
# UNIFI_PROTECT_HOST=192.168.1.1
# UNIFI_PROTECT_USERNAME=admin
# UNIFI_PROTECT_PASSWORD=
# UNIFI_PROTECT_PORT=443
# UNIFI_PROTECT_VERIFY_SSL=false
# UNIFI_PROTECT_SSL_FINGERPRINT=
# UNIFI_PROTECT_API_KEY=              # Protect API key for selected settings capabilities

# ---------------------------------------------------------------------------
# Access server overrides (optional — falls back to shared UNIFI_* above)
# ---------------------------------------------------------------------------
# UNIFI_ACCESS_HOST=192.168.1.1
# UNIFI_ACCESS_USERNAME=admin
# UNIFI_ACCESS_PASSWORD=
# UNIFI_ACCESS_PORT=443
# UNIFI_ACCESS_VERIFY_SSL=false
# UNIFI_ACCESS_SSL_FINGERPRINT=       # Certificate on UNIFI_ACCESS_PORT
# UNIFI_ACCESS_API_SSL_FINGERPRINT=   # Certificate on UNIFI_ACCESS_API_PORT; a different one. Set both if you use both.
# UNIFI_ACCESS_API_KEY=
# UNIFI_ACCESS_API_PORT=12445

# ---------------------------------------------------------------------------
# Site Manager server (Ubiquiti's cloud API at api.ui.com; read-only)
# Its key is a different credential from the console keys above. It is read
# only from this variable: the server never uses UNIFI_API_KEY, and nothing
# above is sent to the cloud. Create the key at unifi.ui.com > Settings > API Keys.
# ---------------------------------------------------------------------------
# UNIFI_SITEMANAGER_API_KEY=
# UNIFI_SITEMANAGER_TIMEOUT_SECONDS=30   # Seconds to wait for one API response

# ---------------------------------------------------------------------------
# MCP server settings (shared by all servers)
# ---------------------------------------------------------------------------
UNIFI_TOOL_REGISTRATION_MODE=lazy
# Every server answers the MCP client at once and connects to the controller in
# the background. Network only: set true to make no connection at startup and
# connect on the first tool call instead; real-time events start after it.
# UNIFI_DEFER_CONTROLLER_INIT=false
# Network eager mode only: set false to omit indirect meta-tools. This requires
# UNIFI_ENABLED_CATEGORIES or UNIFI_ENABLED_TOOLS to provide an allowlist.
# UNIFI_META_TOOLS_ENABLED=true
UNIFI_MCP_LOG_LEVEL=INFO
# HTTP is opt-in and unauthenticated by default; keep it on loopback for local
# clients. Docker Compose enables HTTP on the container network and publishes
# host ports on 127.0.0.1. Remote clients must use an authenticated proxy, Cloud
# Relay, or the bearer token below carried over TLS.
# UNIFI_MCP_HTTP_ENABLED=false
# UNIFI_MCP_HOST=127.0.0.1
# UNIFI_MCP_HTTP_FORCE=true           # Enable HTTP outside container PID 1
# Complete Host-header allowlist for HTTP transport. Keep loopback entries for
# standalone use; Docker Compose separately adds its required service hostnames.
# UNIFI_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,unifi-mcp.example.com
# UNIFI_MCP_ENABLE_DNS_REBINDING_PROTECTION=true
# Require Authorization: Bearer <token> on every HTTP request (openssl rand -hex 32).
# At least 32 printable ASCII characters. Leave the line commented out to run
# without a token: a set-but-empty value refuses startup. Per-server overrides:
# UNIFI_NETWORK_MCP_HTTP_AUTH_TOKEN, UNIFI_PROTECT_..., UNIFI_ACCESS_...; the
# _FILE and _COMMAND spellings are honoured only from the launch environment.
# The Cloud Relay sidecar does not send a token yet: with docker-compose, where
# the relay and the servers share this file, leave it unset or use the
# per-server variables only on servers the relay does not reach.
# UNIFI_MCP_HTTP_AUTH_TOKEN=
# UNIFI_MCP_HTTP_AUTH_TOKEN_FILE=/run/secrets/unifi_mcp_http_auth_token

# MCP structured response content policy: adaptive (default), compat, or compact.
# Adaptive classifies requests by the canonical protocolVersion advertised during
# MCP initialization. MCP 2025-06-18 or later receives concise text plus full
# structuredContent; earlier, missing, or malformed revisions retain full text.
# UNIFI_MCP_CONTENT_MODE=adaptive
# UNIFI_NETWORK_MCP_CONTENT_MODE=adaptive
# UNIFI_PROTECT_MCP_CONTENT_MODE=adaptive
# UNIFI_ACCESS_MCP_CONTENT_MODE=adaptive
# UNIFI_SITEMANAGER_MCP_CONTENT_MODE=adaptive

# OpenTelemetry trace export: setting an OTLP endpoint exports the MCP SDK's
# spans. The Docker images include the OTLP/HTTP exporter; pip/uvx installs need
# the `otel` extra. Other standard OTEL_* variables (sampler, headers) apply too.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf   # Default; grpc needs opentelemetry-exporter-otlp-proto-grpc
# OTEL_SERVICE_NAME=unifi-network-mcp   # Defaults to the server's name

# ---------------------------------------------------------------------------
# Permission Mode (default: confirm)
# Controls how mutations are handled: confirm requires preview-then-confirm, bypass executes immediately
# ---------------------------------------------------------------------------
# UNIFI_TOOL_PERMISSION_MODE=confirm
# UNIFI_NETWORK_TOOL_PERMISSION_MODE=bypass   # Per-server override

# ---------------------------------------------------------------------------
# Preview Tokens (default: false)
# Make confirm=true require the preview_token from a preview of the same call.
# Has no effect in bypass mode. Tokens are single use and held in memory.
# ---------------------------------------------------------------------------
# UNIFI_REQUIRE_PREVIEW_TOKEN=true
# UNIFI_NETWORK_REQUIRE_PREVIEW_TOKEN=true   # Per-server override
# UNIFI_PREVIEW_TOKEN_TTL_SECONDS=300        # 10 to 3600

# ---------------------------------------------------------------------------
# Policy Gates (default: unset = allowed)
# Hard boundaries that disable specific actions. Most specific wins.
# ---------------------------------------------------------------------------
# UNIFI_POLICY_DELETE=false                           # Disable deletes globally
# UNIFI_POLICY_NETWORK_UPDATE=true                    # Enable updates on network server
# UNIFI_POLICY_NETWORK_NETWORKS_UPDATE=false           # Disable network category updates

# ---------------------------------------------------------------------------
# Read-only mode (default: off)
# Denies every non-read action on the MCP servers and the API server; no
# UNIFI_POLICY_* gate overrides it. An unrecognized value turns it on.
# ---------------------------------------------------------------------------
# UNIFI_READ_ONLY=true
# UNIFI_PROTECT_READ_ONLY=true                        # Per-server override

# ---------------------------------------------------------------------------
# Response redaction policy (default: true)
# Redacts secret-bearing fields before returning tool/API responses.
# Set the global value or a server-specific override to false only for trusted
# local administration workflows that require raw secret values.
# ---------------------------------------------------------------------------
# UNIFI_REDACT_SENSITIVE_FIELDS=true
# UNIFI_NETWORK_REDACT_SENSITIVE_FIELDS=true
# UNIFI_PROTECT_REDACT_SENSITIVE_FIELDS=true
# UNIFI_ACCESS_REDACT_SENSITIVE_FIELDS=true
# UNIFI_SITEMANAGER_REDACT_SENSITIVE_FIELDS=true
# UNIFI_API_REDACT_SENSITIVE_FIELDS=true

# ---------------------------------------------------------------------------
# Protect event streaming
# ---------------------------------------------------------------------------
# PROTECT_EVENT_BUFFER_SIZE=100
# PROTECT_EVENT_BUFFER_TTL=300
# PROTECT_WEBSOCKET_ENABLED=true
# PROTECT_SMART_DETECTION_MIN_CONFIDENCE=50

# ---------------------------------------------------------------------------
# Access event streaming
# ---------------------------------------------------------------------------
# ACCESS_EVENT_BUFFER_SIZE=100
# ACCESS_EVENT_BUFFER_TTL=300
# ACCESS_WEBSOCKET_ENABLED=true

# ---------------------------------------------------------------------------
# Network event streaming (feeds unifi_recent_events)
# ---------------------------------------------------------------------------
# Buffer size and TTL must be positive integers; invalid values prevent startup.
# UNIFI_NETWORK_EVENT_BUFFER_SIZE=100
# UNIFI_NETWORK_EVENT_BUFFER_TTL=300
# UNIFI_NETWORK_WEBSOCKET_ENABLED=true

# ── Cloud relay (optional) ───────────────────────
# UNIFI_RELAY_URL=https://your-worker.workers.dev
# UNIFI_RELAY_TOKEN=your-relay-token
# UNIFI_RELAY_LOCATION_NAME=Home Lab
# UNIFI_RELAY_SERVERS=http://localhost:3000
# UNIFI_RELAY_REFRESH_INTERVAL=300
