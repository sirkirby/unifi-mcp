{
  "mcpServers": {
    "unifi-network": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python-preference",
        "system",
        "unifi-network-mcp==0.37.0"
      ],
      "env": {
        "UNIFI_NETWORK_HOST": "${user_config.host}",
        "UNIFI_NETWORK_USERNAME": "${user_config.username}",
        "UNIFI_NETWORK_PASSWORD_FILE": "${user_config.password_file}",
        "UNIFI_NETWORK_PASSWORD_COMMAND": "${user_config.password_command}",
        "UNIFI_NETWORK_PASSWORD": "${user_config.password}",
        "UNIFI_NETWORK_API_KEY_FILE": "${user_config.api_key_file}",
        "UNIFI_NETWORK_API_KEY_COMMAND": "${user_config.api_key_command}",
        "UNIFI_NETWORK_API_KEY": "${user_config.api_key}",
        "UNIFI_NETWORK_PORT": "${user_config.port}",
        "UNIFI_NETWORK_SITE": "${user_config.site}",
        "UNIFI_NETWORK_VERIFY_SSL": "${user_config.verify_ssl}",
        "UNIFI_POLICY_NETWORK_CREATE": "${user_config.policy_create}",
        "UNIFI_POLICY_NETWORK_UPDATE": "${user_config.policy_update}",
        "UNIFI_POLICY_NETWORK_DELETE": "${user_config.policy_delete}",
        "UNIFI_NETWORK_TOOL_PERMISSION_MODE": "${user_config.permission_mode}",
        "UNIFI_AUTO_CONFIRM": "${user_config.auto_confirm}",
        "UNIFI_TOOL_REGISTRATION_MODE": "${user_config.registration_mode}"
      }
    }
  }
}
