{
  "mcpServers": {
    "unifi-protect": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python-preference",
        "system",
        "unifi-protect-mcp==0.9.0"
      ],
      "env": {
        "UNIFI_SETTINGS_FILE": "~/.config/unifi-mcp/protect.env"
      },
      "env_vars": [
        "UNIFI_TOOL_REGISTRATION_MODE",
        "UNIFI_POLICY_CREATE",
        "UNIFI_POLICY_UPDATE",
        "UNIFI_POLICY_DELETE",
        "UNIFI_TOOL_PERMISSION_MODE"
      ]
    }
  }
}
