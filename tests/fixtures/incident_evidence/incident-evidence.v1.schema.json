{
  "$defs": {
    "ApiFamily": {
      "description": "API surfaces with disjoint ID and auth models (see AGENTS.md).",
      "enum": [
        "network_v2_controller",
        "network_integration",
        "alarm_manager_v2",
        "protect_private",
        "protect_public"
      ],
      "title": "ApiFamily",
      "type": "string"
    },
    "BudgetKind": {
      "enum": [
        "window",
        "events",
        "calls",
        "elapsed"
      ],
      "title": "BudgetKind",
      "type": "string"
    },
    "BudgetLimits": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "events": {
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        },
        "window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "window_seconds",
        "events",
        "calls",
        "elapsed_ms"
      ],
      "title": "BudgetLimits",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "default": 0,
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "events": {
          "default": 0,
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "exhausted": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BudgetKind"
          },
          "title": "Exhausted",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/BudgetLimits"
        },
        "usage": {
          "$ref": "#/$defs/BudgetUsage",
          "default": {
            "calls": 0,
            "elapsed_ms": 0,
            "events": 0
          }
        }
      },
      "required": [
        "limits"
      ],
      "title": "Budgets",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "population_total": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "counts": {
                "properties": {
                  "boundary_uncertain": {
                    "const": 0
                  },
                  "conflicting": {
                    "const": 0
                  },
                  "malformed_dropped": {
                    "const": 0
                  },
                  "untimed": {
                    "const": 0
                  }
                }
              },
              "pagination": {
                "properties": {
                  "interrupted": {
                    "const": false
                  },
                  "offset": {
                    "enum": [
                      null,
                      0
                    ]
                  }
                }
              },
              "population_total": {
                "type": "integer"
              },
              "truncation": {
                "const": "not_truncated"
              },
              "window_coverage": {
                "const": "covered"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "queried_window": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "window_coverage": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pagination": {
                "properties": {
                  "has_more": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "truncation": {
                "const": "truncated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pagination": {
                "properties": {
                  "interrupted": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "truncation": {
                "enum": [
                  "truncated",
                  "unknown"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/RecordCounts"
        },
        "filters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Filters",
          "type": "object"
        },
        "observed_first_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed First Utc"
        },
        "observed_last_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Last Utc"
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        },
        "population_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Population Total"
        },
        "queried_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "truncation": {
          "$ref": "#/$defs/Truncation"
        },
        "window_coverage": {
          "$ref": "#/$defs/WindowCoverage"
        }
      },
      "required": [
        "requested_window",
        "queried_window",
        "window_coverage",
        "observed_first_utc",
        "observed_last_utc",
        "filters",
        "pagination",
        "truncation",
        "counts",
        "complete",
        "population_total"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "network_client",
        "network_device",
        "network_station",
        "camera",
        "location"
      ],
      "title": "EntityKind",
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "id_kind": {
          "$ref": "#/$defs/IdKind"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "kind",
        "id_kind",
        "id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EventTime": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "boundary_uncertain": {
                "const": false
              },
              "precision": {
                "type": "null"
              },
              "utc": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "in_window",
                  "out_of_window"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "precision": {
                "type": "string"
              },
              "utc": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "original_type": {
                "enum": [
                  "absent",
                  "null"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "boundary_uncertain": {
          "default": false,
          "title": "Boundary Uncertain",
          "type": "boolean"
        },
        "clock_uncertainty_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clock Uncertainty Ms"
        },
        "original_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Field"
        },
        "original_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimestampFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_type": {
          "$ref": "#/$defs/OriginalType"
        },
        "original_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Value"
        },
        "precision": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimePrecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/TimeStatus"
        },
        "timezone_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimezoneBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Utc"
        },
        "utc_offset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Utc Offset"
        }
      },
      "required": [
        "status",
        "original_field",
        "original_type",
        "original_value",
        "original_format",
        "utc",
        "utc_offset",
        "timezone_basis",
        "precision"
      ],
      "title": "EventTime",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        },
        "conflict_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Group"
        },
        "entities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "title": "Entities",
          "type": "array"
        },
        "event_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Type"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_id_basis": {
          "enum": [
            "source_record_id",
            "content_hash"
          ],
          "title": "Evidence Id Basis",
          "type": "string"
        },
        "mapping": {
          "$ref": "#/$defs/MappingOutcome",
          "default": {
            "confidence": null,
            "matched_on": [],
            "sources": [],
            "status": "not_evaluated",
            "targets": []
          }
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        },
        "time": {
          "$ref": "#/$defs/EventTime"
        }
      },
      "required": [
        "evidence_id",
        "evidence_id_basis",
        "source_id",
        "provenance",
        "time",
        "event_type",
        "summary"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "FailureKind": {
      "enum": [
        "unavailable",
        "auth_failed",
        "permission_denied",
        "timeout",
        "unsupported",
        "parse_failed",
        "partial_response",
        "budget_exhausted"
      ],
      "title": "FailureKind",
      "type": "string"
    },
    "IdKind": {
      "enum": [
        "mac",
        "protect_camera_id",
        "network_device_id",
        "location_id"
      ],
      "title": "IdKind",
      "type": "string"
    },
    "MappingAssertion": {
      "additionalProperties": false,
      "description": "An explicit, exact-identifier association supplied to the investigation.",
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityRef"
        },
        "source": {
          "$ref": "#/$defs/MappingSource"
        },
        "target": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "entity",
        "target",
        "source"
      ],
      "title": "MappingAssertion",
      "type": "object"
    },
    "MappingOutcome": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "const": "exact_identifier"
              },
              "matched_on": {
                "minItems": 1
              },
              "targets": {
                "maxItems": 1,
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "null"
              },
              "targets": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "missing",
                  "not_evaluated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "null"
              },
              "matched_on": {
                "maxItems": 0
              },
              "sources": {
                "maxItems": 0
              },
              "targets": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "const": "exact_identifier",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "matched_on": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "title": "Matched On",
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MappingSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MappingStatus"
        },
        "targets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "MappingOutcome",
      "type": "object"
    },
    "MappingSource": {
      "enum": [
        "operator_input",
        "product_inventory"
      ],
      "title": "MappingSource",
      "type": "string"
    },
    "MappingStatus": {
      "enum": [
        "verified",
        "ambiguous",
        "missing",
        "not_evaluated"
      ],
      "title": "MappingStatus",
      "type": "string"
    },
    "OriginalType": {
      "enum": [
        "absent",
        "null",
        "string",
        "integer",
        "float",
        "boolean",
        "object",
        "array"
      ],
      "title": "OriginalType",
      "type": "string"
    },
    "OverallStatus": {
      "enum": [
        "complete",
        "empty",
        "partial",
        "failed"
      ],
      "title": "OverallStatus",
      "type": "string"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "cap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cap"
        },
        "has_more": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has More"
        },
        "interrupted": {
          "default": false,
          "title": "Interrupted",
          "type": "boolean"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "post_filtered": {
          "default": false,
          "title": "Post Filtered",
          "type": "boolean"
        },
        "requested_cap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Cap"
        },
        "returned": {
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "total_reported": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Reported"
        }
      },
      "required": [
        "returned"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "PartialReason": {
      "enum": [
        "boundary_uncertain",
        "conflicting_records",
        "post_filtered",
        "prefix_not_collected",
        "truncated",
        "truncation_unknown",
        "window_not_covered",
        "window_coverage_unknown",
        "malformed_records",
        "untimed_records",
        "partial_response",
        "budget_exhausted"
      ],
      "title": "PartialReason",
      "type": "string"
    },
    "Product": {
      "enum": [
        "network",
        "protect",
        "access"
      ],
      "title": "Product",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "api_family": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiFamily"
            },
            {
              "type": "null"
            }
          ]
        },
        "collected_at": {
          "title": "Collected At",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Endpoint"
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "query": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Query",
          "type": "object"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Record Id"
        },
        "source_record_id_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Record Id Field"
        },
        "source_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Tool"
        }
      },
      "required": [
        "product",
        "api_family",
        "source_tool",
        "endpoint",
        "scope",
        "source_record_id",
        "source_record_id_field",
        "query",
        "collected_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RecordCounts": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "minimum": 0,
          "title": "Accepted",
          "type": "integer"
        },
        "boundary_uncertain": {
          "default": 0,
          "minimum": 0,
          "title": "Boundary Uncertain",
          "type": "integer"
        },
        "conflicting": {
          "default": 0,
          "minimum": 0,
          "title": "Conflicting",
          "type": "integer"
        },
        "duplicates_dropped": {
          "minimum": 0,
          "title": "Duplicates Dropped",
          "type": "integer"
        },
        "in_window": {
          "minimum": 0,
          "title": "In Window",
          "type": "integer"
        },
        "malformed_dropped": {
          "minimum": 0,
          "title": "Malformed Dropped",
