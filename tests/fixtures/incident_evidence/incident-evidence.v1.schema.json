            "properties": {
              "exhausted": {
                "maxItems": 0
              }
            }
          },
          "sources": {
            "contains": {
              "properties": {
                "outcome": {
                  "const": "complete"
                }
              }
            },
            "items": {
              "properties": {
                "outcome": {
                  "enum": [
                    "complete",
                    "empty"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
