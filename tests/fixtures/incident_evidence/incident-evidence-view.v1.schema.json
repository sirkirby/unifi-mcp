{
  "$defs": {
    "BudgetKind": {
      "enum": [
        "window",
        "events",
        "calls",
        "elapsed"
      ],
      "title": "BudgetKind",
      "type": "string"
    },
    "BudgetLimits": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "events": {
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        },
        "window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "window_seconds",
        "events",
        "calls",
        "elapsed_ms"
      ],
      "title": "BudgetLimits",
      "type": "object"
    },
    "BudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "default": 0,
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "events": {
          "default": 0,
          "minimum": 0,
          "title": "Events",
          "type": "integer"
        }
      },
      "title": "BudgetUsage",
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "exhausted": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BudgetKind"
          },
          "title": "Exhausted",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/BudgetLimits"
        },
        "usage": {
          "$ref": "#/$defs/BudgetUsage",
          "default": {
            "calls": 0,
            "elapsed_ms": 0,
            "events": 0
          }
        }
      },
      "required": [
        "limits"
      ],
      "title": "Budgets",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "population_total": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "counts": {
                "properties": {
                  "boundary_uncertain": {
                    "const": 0
                  },
                  "conflicting": {
                    "const": 0
                  },
                  "malformed_dropped": {
                    "const": 0
                  },
                  "untimed": {
                    "const": 0
                  }
                }
              },
              "pagination": {
                "properties": {
                  "interrupted": {
                    "const": false
                  },
                  "offset": {
                    "enum": [
                      null,
                      0
                    ]
                  }
                }
              },
              "population_total": {
                "type": "integer"
              },
              "truncation": {
                "const": "not_truncated"
              },
              "window_coverage": {
                "const": "covered"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "queried_window": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "window_coverage": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truncation": {
                "const": "not_truncated"
              }
            }
          },
          "then": {
            "properties": {
              "pagination": {
                "anyOf": [
                  {
                    "properties": {
                      "has_more": {
                        "const": false
                      }
                    }
                  },
                  {
                    "properties": {
                      "post_filtered": {
                        "const": false
                      },
                      "total_reported": {
                        "type": "integer"
                      }
                    }
                  }
                ],
                "properties": {
                  "interrupted": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truncation": {
                "const": "truncated"
              }
            }
          },
          "then": {
            "properties": {
              "pagination": {
                "anyOf": [
                  {
                    "properties": {
                      "has_more": {
                        "const": true
                      }
                    }
                  },
                  {
                    "properties": {
                      "post_filtered": {
                        "const": false
                      },
                      "total_reported": {
                        "type": "integer"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "observed_first_utc": {
                "type": "string"
              },
              "observed_last_utc": {
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "counts": {
                "properties": {
                  "in_window": {
                    "const": 0
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "observed_first_utc": {
                "type": "null"
              },
              "observed_last_utc": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pagination": {
                "properties": {
                  "has_more": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "truncation": {
                "const": "truncated"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pagination": {
                "properties": {
                  "interrupted": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "truncation": {
                "enum": [
                  "truncated",
                  "unknown"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/RecordCounts"
        },
        "filters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "not": {
              "pattern": "pass|psk|secret|token|auth|cookie|key|community|pin|rtsp|crypt|configuration"
            },
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Filters",
          "type": "object"
        },
        "observed_first_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed First Utc"
        },
        "observed_last_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Last Utc"
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        },
        "population_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Population Total"
        },
        "queried_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "retention_coverage": {
          "$ref": "#/$defs/RetentionCoverage"
        },
        "truncation": {
          "$ref": "#/$defs/Truncation"
        },
        "window_coverage": {
          "$ref": "#/$defs/WindowCoverage"
        }
      },
      "required": [
        "requested_window",
        "queried_window",
        "window_coverage",
        "observed_first_utc",
        "observed_last_utc",
        "filters",
        "pagination",
        "truncation",
        "retention_coverage",
        "counts",
        "complete",
        "population_total"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "network_client",
        "network_device",
        "network_station",
        "camera",
        "location"
      ],
      "title": "EntityKind",
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "id_kind": {
          "$ref": "#/$defs/IdKind"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "kind",
        "id_kind",
        "id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "FailureKind": {
      "enum": [
        "unavailable",
        "auth_failed",
        "permission_denied",
        "timeout",
        "unsupported",
        "parse_failed",
        "partial_response",
        "budget_exhausted"
      ],
      "title": "FailureKind",
      "type": "string"
    },
    "IdKind": {
      "enum": [
        "mac",
        "protect_camera_id",
        "network_device_id",
        "location_id"
      ],
      "title": "IdKind",
      "type": "string"
    },
    "MappingAssertion": {
      "additionalProperties": false,
      "description": "An explicit, exact-identifier association supplied to the investigation.",
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityRef"
        },
        "source": {
          "$ref": "#/$defs/MappingSource"
        },
        "target": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "entity",
        "target",
        "source"
      ],
      "title": "MappingAssertion",
      "type": "object"
    },
    "MappingSource": {
      "enum": [
        "operator_input",
        "product_inventory"
      ],
      "title": "MappingSource",
      "type": "string"
    },
    "MappingStatus": {
      "enum": [
        "verified",
        "ambiguous",
        "missing",
        "not_evaluated"
      ],
      "title": "MappingStatus",
      "type": "string"
    },
    "OriginalType": {
      "enum": [
        "absent",
        "null",
        "string",
        "integer",
        "float",
        "boolean",
        "object",
        "array"
      ],
      "title": "OriginalType",
      "type": "string"
    },
    "OverallStatus": {
      "enum": [
        "complete",
        "empty",
        "partial",
        "failed"
      ],
      "title": "OverallStatus",
      "type": "string"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "cap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cap"
        },
        "has_more": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has More"
        },
        "interrupted": {
          "default": false,
          "title": "Interrupted",
          "type": "boolean"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset"
        },
        "post_filtered": {
          "default": false,
          "title": "Post Filtered",
          "type": "boolean"
        },
        "requested_cap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Cap"
        },
        "returned": {
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "total_reported": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Reported"
        }
      },
      "required": [
        "returned"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "PartialReason": {
      "enum": [
        "boundary_uncertain",
        "conflicting_records",
        "post_filtered",
        "prefix_not_collected",
        "truncated",
        "truncation_unknown",
        "window_not_covered",
        "window_coverage_unknown",
        "malformed_records",
        "untimed_records",
        "partial_response",
        "budget_exhausted"
      ],
      "title": "PartialReason",
      "type": "string"
    },
    "Product": {
      "enum": [
        "network",
        "protect",
        "access"
      ],
      "title": "Product",
      "type": "string"
    },
    "RecordCounts": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "minimum": 0,
          "title": "Accepted",
          "type": "integer"
        },
        "boundary_uncertain": {
          "default": 0,
          "minimum": 0,
          "title": "Boundary Uncertain",
          "type": "integer"
        },
        "conflicting": {
          "default": 0,
          "minimum": 0,
          "title": "Conflicting",
          "type": "integer"
        },
        "duplicates_dropped": {
          "minimum": 0,
          "title": "Duplicates Dropped",
          "type": "integer"
        },
        "in_window": {
          "minimum": 0,
          "title": "In Window",
          "type": "integer"
        },
        "malformed_dropped": {
          "minimum": 0,
          "title": "Malformed Dropped",
          "type": "integer"
        },
        "out_of_window": {
          "minimum": 0,
          "title": "Out Of Window",
          "type": "integer"
        },
        "received": {
          "minimum": 0,
          "title": "Received",
          "type": "integer"
        },
        "untimed": {
          "minimum": 0,
          "title": "Untimed",
          "type": "integer"
        }
      },
      "required": [
        "received",
        "accepted",
        "in_window",
        "out_of_window",
        "untimed",
        "malformed_dropped",
        "duplicates_dropped"
      ],
      "title": "RecordCounts",
      "type": "object"
    },
    "RecordSelection": {
      "additionalProperties": false,
      "description": "Which collected records the view returns; omission never reduces coverage.\n\n``before_resume`` counts records at or before ``resume_after`` (shown by\nearlier views), ``omitted`` every other record not returned, including the\n``too_large`` records this view skipped. ``next_cursor`` is set exactly\nwhen ``limited_by`` says which limit stopped the view.",
      "properties": {
        "before_resume": {
          "$ref": "#/$defs/RecordTally"
        },
        "collected": {
          "$ref": "#/$defs/RecordTally"
        },
        "limited_by": {
          "anyOf": [
            {
              "enum": [
                "max_records_returned",
                "output_budget"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Limited By"
        },
        "max_records_returned": {
          "maximum": 50,
          "minimum": 1,
          "title": "Max Records Returned",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "omission": {
          "const": "presentation_limit",
          "default": "presentation_limit",
          "title": "Omission",
          "type": "string"
        },
        "omitted": {
          "$ref": "#/$defs/RecordTally"
        },
        "resume_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resume After"
        },
        "returned": {
          "$ref": "#/$defs/RecordTally"
        },
        "too_large": {
          "minimum": 0,
          "title": "Too Large",
          "type": "integer"
        }
      },
      "required": [
        "max_records_returned",
        "resume_after",
        "collected",
        "before_resume",
        "returned",
        "omitted",
        "too_large",
        "limited_by",
        "next_cursor"
      ],
      "title": "RecordSelection",
      "type": "object"
    },
    "RecordTally": {
      "additionalProperties": false,
      "properties": {
        "in_window": {
          "minimum": 0,
          "title": "In Window",
          "type": "integer"
        },
        "out_of_window": {
          "minimum": 0,
          "title": "Out Of Window",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "untimed": {
          "minimum": 0,
          "title": "Untimed",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "in_window",
        "out_of_window",
        "untimed"
      ],
      "title": "RecordTally",
      "type": "object"
    },
    "RetentionCoverage": {
      "description": "Whether the controller still held every event of the queried window.\n\nNeither product reports its oldest retained event, so this is always\n``unknown``: an empty source means no event was returned, not that none\noccurred before the controller discarded it.",
      "enum": [
        "unknown"
      ],
      "title": "RetentionCoverage",
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "controller_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Controller Id"
        },
        "location_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "site": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "SourceFailure": {
      "additionalProperties": false,
      "description": "Why a source failed; exception text is never carried.",
      "properties": {
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "kind": {
          "$ref": "#/$defs/FailureKind"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SourceFailure",
      "type": "object"
    },
    "SourceOutcome": {
      "enum": [
        "complete",
        "empty",
        "partial",
        "unavailable",
        "auth_failed",
        "permission_denied",
        "timeout",
        "unsupported",
        "parse_failed",
        "not_attempted"
      ],
      "title": "SourceOutcome",
      "type": "string"
    },
    "TimeStatus": {
      "enum": [
        "in_window",
        "out_of_window",
        "missing",
        "malformed",
        "ambiguous_timezone"
      ],
      "title": "TimeStatus",
      "type": "string"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Half-open UTC interval ``[start, end)``; the boundary flags are fixed.",
      "properties": {
        "end": {
          "title": "End",
          "type": "string"
        },
        "end_inclusive": {
          "const": false,
          "default": false,
          "title": "End Inclusive",
          "type": "boolean"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "start_inclusive": {
          "const": true,
          "default": true,
          "title": "Start Inclusive",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "Truncation": {
      "enum": [
        "not_truncated",
        "truncated",
        "unknown"
      ],
      "title": "Truncation",
      "type": "string"
    },
    "ViewMapping": {
      "additionalProperties": false,
      "description": "A record's mapping outcome: its target IDs and the assertion sources behind them.",
      "properties": {
        "sources": {
          "items": {
            "$ref": "#/$defs/MappingSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MappingStatus"
        },
        "target_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "target_ids",
        "sources"
      ],
      "title": "ViewMapping",
      "type": "object"
    },
    "ViewRecord": {
      "additionalProperties": false,
      "description": "One record in citation form; ``evidence_id`` begins with its source ID.\n\n``conflict_group`` is present on every version of one identity, as in the\nfull document, and absent otherwise: records sharing it are differing\nversions, never distinct events. It is the evidence ID without its\n``|version|<digest>`` suffix, so it is always shorter than the cited ID.\n``truncated`` names each free-text field cut to a prefix, with its full\nlength in characters; identifiers are never cut.",
      "else": {
        "not": {
          "required": [
            "conflict_group"
          ]
        }
      },
      "if": {
        "properties": {
          "evidence_id": {
            "pattern": "\\|version\\|[0-9a-f]{24}$"
          }
        }
      },
      "properties": {
        "conflict_group": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}\\|(?:(?:int|str)\\|[A-Za-z0-9%._~-]+|fields\\|[0-9a-f]{24})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Group"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
